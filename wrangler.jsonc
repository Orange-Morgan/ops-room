{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ops-room",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": [
    // The Agents SDK needs Node.js APIs.
    "nodejs_compat",
    // Lets your watchkeeper call your own /mcp endpoint (and your partner cell's)
    // over the public internet, the same way Cloudflare OS or AI Playground would.
    "global_fetch_strictly_public"
  ],

  // The ops board and chat UI in ./public. Requests to the paths below run
  // the Worker first; everything else is served straight from static assets.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/mcp", "/agents/*"]
  },

  // Workers AI: the model your watchkeeper thinks with.
  "ai": {
    "binding": "AI",
    "remote": true
  },

  "vars": {
    // Any Workers AI model with function calling works. This one is fast, reliable
    // with tools and available on the free plan (about 80 agent replies a day).
    "MODEL": "@cf/openai/gpt-oss-120b",

    // Steps in by itself when a call to MODEL takes more than 12 seconds or fails,
    // and stays in for three minutes. It costs less than MODEL and passes the same
    // tests, but it is slower on a good day. Set it to "none" to switch this off.
    "MODEL_FALLBACK": "@cf/google/gemma-4-26b-a4b-it",

    // Exercise control (EXCON) for the event. Your ops room reports here so it shows
    // on the big screen, and EXCON sends injects back. Set it to "" to run on your own.
    "EXCON_URL": "https://orange-cloud-excon.jleitao.workers.dev"
  },

  // OpsRoom: your cell's database (stores, requests, sites, mission board).
  // Watchkeeper: one agent instance per chat session.
  "durable_objects": {
    "bindings": [
      { "name": "OPS", "class_name": "OpsRoom" },
      { "name": "Watchkeeper", "class_name": "Watchkeeper" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["OpsRoom", "Watchkeeper"] }
  ],

  "observability": { "enabled": true }
}
